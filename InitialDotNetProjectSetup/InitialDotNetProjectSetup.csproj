<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<IncludeSwagger Condition="'$(IncludeSwagger)' == ''">true</IncludeSwagger>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(IncludeSwagger)' == 'true' ">
		<DefineConstants>$(DefineConstants);IncludeSwagger</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Content Include=".template.config\template.json" />
	</ItemGroup>

	<ItemGroup Condition=" '$(IncludeSwagger)' == 'true' ">
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
	</ItemGroup>

</Project>