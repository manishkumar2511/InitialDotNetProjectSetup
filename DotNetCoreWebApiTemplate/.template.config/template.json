{
  "$schema": "http://json.schemastore.org/template",
  "author": "Manish Kumar",
  "classifications": [ "Web API", "C#", "Cloud" ],
  "identity": "DotNetCoreWebApiTemplate.Identity",
  "name": "DotNetCore Web API Template",
  "shortName": "dotnetcore-webapi",
  "sourceName": "DotNetCoreWebApiTemplate",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "IncludeSwagger": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "isRequired": false,
      "description": "Include Swagger/OpenAPI documentation?"
    }
  },
  "primaryOutputs": [
    { "path": "DotNetCoreWebApiTemplate.csproj" }
  ]
}